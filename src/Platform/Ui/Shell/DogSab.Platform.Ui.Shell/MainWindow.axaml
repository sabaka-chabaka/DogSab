<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DogSab.Platform.Ui.Shell.MainWindow"
        Title="DogSab"
        Width="1280" Height="800">
    <DockPanel>
        <ContentControl x:Name="MenuBarHost" DockPanel.Dock="Top" />
        <ContentControl x:Name="StatusBarHost" DockPanel.Dock="Bottom" />
        <ContentControl x:Name="CentralContentHost" />
    </DockPanel>
</Window>