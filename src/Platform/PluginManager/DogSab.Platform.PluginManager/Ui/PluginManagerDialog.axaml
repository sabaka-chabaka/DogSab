<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DogSab.Platform.PluginManager.Ui.PluginManagerDialog"
        Title="Manage Plugins"
        Width="700" Height="450">
    <Grid RowDefinitions="Auto,*" Margin="12">
        <Button x:Name="InstallFromFileButton" Grid.Row="0" Content="Install from file..." Margin="0,0,0,8" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <ScrollViewer Grid.Column="0">
                <ItemsControl x:Name="PluginsList" />
            </ScrollViewer>
            <ContentControl x:Name="DetailsHost" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>