<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DogSab.Platform.PluginManager.Ui.PluginListItemView">
    <Grid ColumnDefinitions="*,Auto,Auto" Margin="6,4">
        <StackPanel Grid.Column="0">
            <TextBlock x:Name="NameText" FontWeight="Bold" />
            <TextBlock x:Name="VersionText" Foreground="Gray" FontSize="11" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Margin="8,0" />
        <Button x:Name="ActionButton" Grid.Column="2" />
    </Grid>
</UserControl>